#!/bin/bash
# Deployment script for Jekyll site to GitHub Pages
# Pushes the built _site directory to the gh-pages branch

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Check if we're in the right directory
check_project_root() {
    if [ ! -f "Gemfile" ] || [ ! -f "_config.yml" ]; then
        log_error "This script must be run from the Jekyll project root directory"
        exit 1
    fi
    log_info "Project root directory confirmed"
}

# Check if _site directory exists or restore from cache
check_build_output() {
    # Check if _site directory exists
    if [ ! -d "_site" ]; then
        log_warning "_site directory not found. Checking for cached build..."
        
        # Try to restore from best available cache (prioritize higher Ruby versions)
        local primary_version="${PRIMARY_RUBY_VERSION:-3.3}"
        local fallback_version=$(echo "${primary_version}" | awk -F. '{print $1"."($2-1)}')
        
        if [ -f "_site-ruby-${primary_version}.tar.gz" ]; then
            log_info "Restoring site from Ruby ${primary_version} cache..."
            tar -xzf "_site-ruby-${primary_version}.tar.gz"
            log_success "Site restored from Ruby ${primary_version} cache"
        elif [ -f "_site-ruby-${fallback_version}.tar.gz" ]; then
            log_info "Restoring site from Ruby ${fallback_version} cache..."
            tar -xzf "_site-ruby-${fallback_version}.tar.gz"
            log_success "Site restored from Ruby ${fallback_version} cache"
        elif [ -f "_site.tar.gz" ]; then
            log_info "Restoring site from generic cache..."
            tar -xzf _site.tar.gz
            log_success "Site restored from generic cache"
        else
            log_error "_site directory not found and no cached build available. Build may have failed."
            exit 1
        fi
    fi
    
    if [ ! -f "_site/index.html" ]; then
        log_error "_site/index.html not found. Build may be incomplete."
        exit 1
    fi
    
    log_info "Site structure verified:"
    ls -la _site/ | head -10
    
    log_success "Build output verified"
}

# Configure Git for deployment
configure_git() {
    log_info "Configuring Git for deployment..."
    
    # Set Git user information from environment variables
    git config --global user.name "${GIT_USER_NAME}"
    git config --global user.email "${GIT_USER_EMAIL}"
    
    # Configure Git to use the token for authentication
    git config --global credential.helper store
    echo "https://${GITHUB_TOKEN}@github.com" > ~/.git-credentials
    
    log_success "Git configured for deployment"
}

# Deploy to gh-pages branch
deploy_to_gh_pages() {
    log_info "Starting deployment to gh-pages branch..."
    
    # Get the repository URL
    REPO_URL=$(git config --get remote.origin.url)
    log_info "Repository URL: $REPO_URL"
    
    # Create a temporary directory for the gh-pages branch
    TEMP_DIR=$(mktemp -d)
    log_info "Using temporary directory: $TEMP_DIR"
    
    # Clone the repository to the temporary directory
    cd "$TEMP_DIR"
    git clone --depth 1 --branch gh-pages "$REPO_URL" gh-pages-repo || {
        log_warning "gh-pages branch doesn't exist, creating it..."
        git clone --depth 1 "$REPO_URL" gh-pages-repo
        cd gh-pages-repo
        git checkout --orphan gh-pages
        git rm -rf . || true
        cd ..
    }
    
    cd gh-pages-repo
    
    # Remove all files except .git
    find . -maxdepth 1 -not -name '.git' -not -name '.' -exec rm -rf {} + || true
    
    # Copy the entire _site directory to site folder
    cp -r /home/travis/build/DPP4ResearchGroup/SyntenyViz/_site ./site
    
    # Log the deployment structure
    log_info "Deployment structure:"
    ls -la . | head -10
    log_info "Site contents:"
    ls -la site/ | head -10
    
    # Add all files
    git add .
    
    # Check if there are changes to commit
    if git diff --staged --quiet; then
        log_warning "No changes to deploy"
        return 0
    fi
    
    # Commit the changes
    git commit -m "Deploy Jekyll site from commit $(cd /home/travis/build/DPP4ResearchGroup/SyntenyViz && git rev-parse HEAD)"
    
    # Push to gh-pages branch
    git push origin gh-pages
    
    log_success "Successfully deployed to gh-pages branch"
    
    # Clean up
    cd /home/travis/build/DPP4ResearchGroup/SyntenyViz
    rm -rf "$TEMP_DIR"
}

# Verify deployment
verify_deployment() {
    log_info "Verifying deployment..."
    
    # Wait a moment for GitHub Pages to process
    sleep 10
    
    # Check if the site is accessible (optional)
    log_info "Deployment completed. GitHub Pages should be updated shortly."
    log_info "Site URL: https://dpp4researchgroup.github.io/SyntenyViz/site/"
}

# Main execution
main() {
    log_info "Starting GitHub Pages deployment..."
    
    check_project_root
    check_build_output
    configure_git
    deploy_to_gh_pages
    verify_deployment
    
    log_success "Deployment completed successfully!"
}

# Run main function
main "$@"
