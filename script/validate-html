#!/usr/bin/env ruby
# frozen_string_literal: true

require 'w3c_validators'
require 'fileutils'
require 'timeout'

# Configuration
SITE_DIR = File.expand_path('../_site', __dir__)
TIMEOUT_SECONDS = 30
MAX_RETRIES = 3

# Colors for output
class Colors
  RED = "\033[0;31m"
  GREEN = "\033[0;32m"
  YELLOW = "\033[1;33m"
  BLUE = "\033[0;34m"
  NC = "\033[0m" # No Color
end

# Logging functions
def log_info(message)
  puts "#{Colors::BLUE}[INFO]#{Colors::NC} #{message}"
end

def log_success(message)
  puts "#{Colors::GREEN}[SUCCESS]#{Colors::NC} #{message}"
end

def log_warning(message)
  puts "#{Colors::YELLOW}[WARNING]#{Colors::NC} #{message}"
end

def log_error(message)
  puts "#{Colors::RED}[ERROR]#{Colors::NC} #{message}"
end

# Check if site directory exists
def check_site_directory
  unless Dir.exist?(SITE_DIR)
    log_error "Site directory not found: #{SITE_DIR}"
    log_info "Run 'bundle exec jekyll build' first"
    exit 1
  end
  log_success "Site directory found: #{SITE_DIR}"
end

# Get validator for file type
def get_validator(file_path)
  extension = File.extname(file_path).downcase
  
  case extension
  when '.html'
    W3CValidators::NuValidator.new
  when '.css'
    W3CValidators::CSSValidator.new
  else
    log_warning "No validator available for file type: #{extension}"
    nil
  end
end

# Basic HTML structure validation
def check_html_structure(content)
  errors = []
  errors << 'Missing DOCTYPE declaration' unless content.match?(/<!DOCTYPE\s+html>/i)
  errors << 'Missing <html> tag' unless content.match?(/<html[^>]*>/i)
  errors << 'Missing <head> tag' unless content.match?(/<head[^>]*>/i)
  errors << 'Missing <body> tag' unless content.match?(/<body[^>]*>/i)
  errors
end

# Basic CSS structure validation
def check_css_structure(content)
  errors = []
  errors << 'No CSS rules found' unless content.match?(/\{[^}]*\}/)
  errors << 'Unclosed CSS rule' if content.match?(/\{[^}]*$/)
  errors
end

# Validate a single file with retry logic
def validate_file(file_path, retry_count = 0)
  log_info "Validating #{file_path}..."
  
  unless File.exist?(file_path)
    log_error "File not found: #{file_path}"
    return false
  end
  
  extension = File.extname(file_path).downcase
  file_type = extension == '.html' ? 'HTML' : 'CSS'
  
  # First try W3C validation
  validator = get_validator(file_path)
  if validator
    begin
      # Use timeout to prevent hanging
      results = Timeout.timeout(TIMEOUT_SECONDS) do
        validator.validate_file(file_path)
      end
      
      if results.errors.empty? && results.warnings.empty?
        log_success "#{file_path} is valid!"
        return true
      end
      
      # Report errors
      unless results.errors.empty?
        log_error "W3C validation errors in #{file_path}:"
        results.errors.each { |err| puts "  #{err.to_s}" }
      end
      
      # Report warnings
      unless results.warnings.empty?
        log_warning "W3C validation warnings in #{file_path}:"
        results.warnings.each { |warn| puts "  #{warn.to_s}" }
      end
      
      # Only fail on errors, not warnings
      return results.errors.empty?
      
    rescue Timeout::Error
      log_error "W3C validation timed out for #{file_path} after #{TIMEOUT_SECONDS}s"
      
      if retry_count < MAX_RETRIES
        log_info "Retrying W3C validation (attempt #{retry_count + 1}/#{MAX_RETRIES})..."
        sleep 2
        return validate_file(file_path, retry_count + 1)
      else
        log_warning "W3C validation failed after #{MAX_RETRIES} attempts, falling back to basic validation"
      end
      
    rescue => e
      log_warning "W3C validator unavailable for #{file_path}: #{e.message}"
      log_info "Falling back to basic validation..."
    end
  end
  
  # Fallback to basic validation
  log_info "Performing basic #{file_type} validation for #{File.basename(file_path)}..."
  content = File.read(file_path)
  
  errors = if file_type == 'HTML'
             check_html_structure(content)
           else
             check_css_structure(content)
           end
  
  if errors.empty?
    log_success "Basic validation passed for #{file_path}!"
    true
  else
    log_error "Basic validation errors in #{file_path}:"
    errors.each { |err| puts "  #{err}" }
    false
  end
end

# Find all HTML and CSS files in the site directory
def find_files_to_validate
  files = []
  
  # Find HTML files
  html_files = Dir.glob(File.join(SITE_DIR, '**', '*.html'))
  files.concat(html_files)
  
  # Find CSS files
  css_files = Dir.glob(File.join(SITE_DIR, '**', '*.css'))
  files.concat(css_files)
  
  # Remove duplicates and sort
  files.uniq.sort
end

# Validate all files
def validate_all_files
  files = find_files_to_validate
  
  if files.empty?
    log_warning "No HTML or CSS files found to validate"
    return true
  end
  
  log_info "Found #{files.length} files to validate"
  
  failed_files = []
  validated_count = 0
  
  files.each do |file|
    relative_path = file.sub("#{SITE_DIR}/", '')
    
    if validate_file(file)
      validated_count += 1
    else
      failed_files << relative_path
    end
  end
  
  # Summary
  log_info "Validation summary:"
  log_info "  Total files: #{files.length}"
  log_info "  Valid files: #{validated_count}"
  log_info "  Failed files: #{failed_files.length}"
  
  if failed_files.any?
    log_error "Failed files:"
    failed_files.each { |file| puts "  - #{file}" }
    return false
  end
  
  log_success "All files validated successfully!"
  true
end

# Check for common issues
def check_common_issues
  log_info "Checking for common issues..."
  
  issues_found = false
  
  # Check for missing favicon
  favicon_path = File.join(SITE_DIR, 'favicon.ico')
  unless File.exist?(favicon_path)
    log_warning "Favicon not found: favicon.ico"
  end
  
  # Check for missing robots.txt
  robots_path = File.join(SITE_DIR, 'robots.txt')
  unless File.exist?(robots_path)
    log_warning "robots.txt not found"
  end
  
  # Check for large files
  large_files = Dir.glob(File.join(SITE_DIR, '**', '*')).select do |file|
    File.file?(file) && File.size(file) > 1024 * 1024 # 1MB
  end
  
  if large_files.any?
    log_warning "Large files found (>1MB):"
    large_files.each do |file|
      size = File.size(file) / (1024.0 * 1024.0)
      relative_path = file.sub("#{SITE_DIR}/", '')
      puts "  - #{relative_path} (#{size.round(2)}MB)"
    end
  end
  
  # Check for broken internal links (basic check)
  html_files = Dir.glob(File.join(SITE_DIR, '**', '*.html'))
  html_files.each do |html_file|
    content = File.read(html_file)
    
    # Look for href attributes that might be broken
    content.scan(/href=["']([^"']+)["']/) do |match|
      href = match[0]
      next if href.start_with?('http', 'mailto:', 'tel:', '#')
      
      # Check if the linked file exists
      linked_path = File.join(File.dirname(html_file), href)
      unless File.exist?(linked_path)
        log_warning "Possible broken link in #{html_file.sub("#{SITE_DIR}/", '')}: #{href}"
        issues_found = true
      end
    end
  end
  
  issues_found
end

# Main execution
def main
  log_info "Starting HTML/CSS validation..."
  
  start_time = Time.now
  
  check_site_directory
  
  validation_success = validate_all_files
  issues_found = check_common_issues
  
  end_time = Time.now
  duration = (end_time - start_time).round(2)
  
  if validation_success && !issues_found
    log_success "Validation completed successfully in #{duration}s!"
    exit 0
  elsif validation_success
    log_warning "Validation completed with warnings in #{duration}s"
    exit 0
  else
    log_error "Validation failed after #{duration}s"
    exit 1
  end
end

# Run main function
main