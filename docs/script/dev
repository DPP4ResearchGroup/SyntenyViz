#!/bin/bash
# Development script for Jekyll site
# Provides common development tasks and utilities

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
SITE_DIR="_site"
JEKYLL_PORT=4000
JEKYLL_HOST="127.0.0.1"

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Show usage information
show_usage() {
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  serve          Start Jekyll development server"
    echo "  build          Build the site"
    echo "  clean          Clean build artifacts"
    echo "  test           Run all tests and validations"
    echo "  watch          Build and serve with auto-reload"
    echo "  check          Check site health and performance"
    echo "  setup          Initial setup (run once)"
    echo "  help           Show this help message"
    echo ""
    echo "Options:"
    echo "  --port PORT    Set Jekyll server port (default: $JEKYLL_PORT)"
    echo "  --host HOST    Set Jekyll server host (default: $JEKYLL_HOST)"
    echo "  --drafts       Include draft posts"
    echo "  --future       Include future-dated posts"
    echo "  --verbose      Enable verbose output"
    echo ""
    echo "Examples:"
    echo "  $0 serve --port 8080"
    echo "  $0 build --verbose"
    echo "  $0 test"
}

# Check prerequisites
check_prerequisites() {
    if [ ! -f "Gemfile" ] || [ ! -f "_config.yml" ]; then
        log_error "This script must be run from the Jekyll project root directory"
        exit 1
    fi
    
    if ! command -v bundle >/dev/null 2>&1; then
        log_error "Bundler is not installed. Run 'script/setup' first."
        exit 1
    fi
    
    if [ ! -f "Gemfile.lock" ]; then
        log_error "Dependencies not installed. Run 'script/setup' first."
        exit 1
    fi
}

# Parse command line arguments
parse_args() {
    COMMAND=""
    JEKYLL_ARGS=""
    VERBOSE=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            serve|build|clean|test|watch|check|setup|help)
                COMMAND="$1"
                shift
                ;;
            --port)
                JEKYLL_PORT="$2"
                shift 2
                ;;
            --host)
                JEKYLL_HOST="$2"
                shift 2
                ;;
            --drafts)
                JEKYLL_ARGS="$JEKYLL_ARGS --drafts"
                shift
                ;;
            --future)
                JEKYLL_ARGS="$JEKYLL_ARGS --future"
                shift
                ;;
            --verbose)
                VERBOSE=true
                JEKYLL_ARGS="$JEKYLL_ARGS --verbose"
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_usage
                exit 1
                ;;
        esac
    done
    
    if [ -z "$COMMAND" ]; then
        log_error "No command specified"
        show_usage
        exit 1
    fi
}

# Setup initial environment
setup_environment() {
    log_info "Setting up development environment..."
    
    if [ ! -f "Gemfile.lock" ]; then
        log_info "Installing dependencies..."
        script/bootstrap
    else
        log_info "Dependencies already installed"
    fi
    
    # Create necessary directories
    mkdir -p _site
    mkdir -p .jekyll-cache
    
    log_success "Development environment ready!"
}

# Start Jekyll development server
serve_site() {
    log_info "Starting Jekyll development server..."
    log_info "Server will be available at: http://$JEKYLL_HOST:$JEKYLL_PORT"
    log_info "Press Ctrl+C to stop the server"
    
    bundle exec jekyll serve --host "$JEKYLL_HOST" --port "$JEKYLL_PORT" $JEKYLL_ARGS
}

# Build the site
build_site() {
    log_info "Building Jekyll site..."
    
    if [ "$VERBOSE" = true ]; then
        bundle exec jekyll build --verbose $JEKYLL_ARGS
    else
        bundle exec jekyll build $JEKYLL_ARGS
    fi
    
    if [ -d "$SITE_DIR" ] && [ -f "$SITE_DIR/index.html" ]; then
        log_success "Site built successfully in $SITE_DIR"
        
        # Show build statistics
        local html_count=$(find "$SITE_DIR" -name "*.html" | wc -l)
        local css_count=$(find "$SITE_DIR" -name "*.css" | wc -l)
        local js_count=$(find "$SITE_DIR" -name "*.js" | wc -l)
        local img_count=$(find "$SITE_DIR" -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.gif" -o -name "*.svg" | wc -l)
        local total_size=$(du -sh "$SITE_DIR" 2>/dev/null | cut -f1)
        
        log_info "Build statistics:"
        log_info "  HTML files: $html_count"
        log_info "  CSS files: $css_count"
        log_info "  JS files: $js_count"
        log_info "  Images: $img_count"
        log_info "  Total size: $total_size"
    else
        log_error "Build failed - no output generated"
        exit 1
    fi
}

# Clean build artifacts
clean_site() {
    log_info "Cleaning build artifacts..."
    
    if [ -d "$SITE_DIR" ]; then
        rm -rf "$SITE_DIR"
        log_success "Removed $SITE_DIR"
    fi
    
    if [ -d ".jekyll-cache" ]; then
        rm -rf ".jekyll-cache"
        log_success "Removed .jekyll-cache"
    fi
    
    if [ -d ".sass-cache" ]; then
        rm -rf ".sass-cache"
        log_success "Removed .sass-cache"
    fi
    
    # Clean gem builds
    rm -f jekyll-theme-midnight-*.gem
    
    log_success "Clean completed"
}

# Run all tests and validations
test_site() {
    log_info "Running comprehensive tests..."
    
    # Build the site first
    build_site
    
    # Run CI build script which includes all validations
    script/cibuild
    
    log_success "All tests passed!"
}

# Watch mode - build and serve with auto-reload
watch_site() {
    log_info "Starting watch mode (build + serve with auto-reload)..."
    
    # Build first
    build_site
    
    # Start server with auto-reload
    bundle exec jekyll serve --host "$JEKYLL_HOST" --port "$JEKYLL_PORT" --livereload $JEKYLL_ARGS
}

# Check site health and performance
check_site() {
    log_info "Checking site health and performance..."
    
    # Build the site first
    build_site
    
    # Run HTML validation
    log_info "Running HTML validation..."
    script/validate-html
    
    # Check for common issues
    log_info "Checking for common issues..."
    
    # Check file sizes
    local large_files=$(find "$SITE_DIR" -type f -size +1M | wc -l)
    if [ "$large_files" -gt 0 ]; then
        log_warning "Found $large_files large files (>1MB):"
        find "$SITE_DIR" -type f -size +1M -exec ls -lh {} \; | awk '{print "  " $9 " (" $5 ")"}'
    fi
    
    # Check for missing alt attributes in images
    local images_without_alt=$(grep -r "<img" "$SITE_DIR" | grep -v "alt=" | wc -l)
    if [ "$images_without_alt" -gt 0 ]; then
        log_warning "Found $images_without_alt images without alt attributes"
    fi
    
    # Check for broken internal links (basic check)
    log_info "Checking for broken internal links..."
    local broken_links=0
    find "$SITE_DIR" -name "*.html" -exec grep -l "href=" {} \; | while read -r file; do
        grep -o 'href="[^"]*"' "$file" | sed 's/href="//;s/"//' | while read -r link; do
            if [[ "$link" != http* && "$link" != mailto:* && "$link" != tel:* && "$link" != \#* ]]; then
                local target_file="$SITE_DIR/$link"
                if [ ! -f "$target_file" ]; then
                    log_warning "Possible broken link: $link in $file"
                    broken_links=$((broken_links + 1))
                fi
            fi
        done
    done
    
    log_success "Site health check completed"
}

# Main execution
main() {
    parse_args "$@"
    
    case "$COMMAND" in
        serve)
            check_prerequisites
            serve_site
            ;;
        build)
            check_prerequisites
            build_site
            ;;
        clean)
            clean_site
            ;;
        test)
            check_prerequisites
            test_site
            ;;
        watch)
            check_prerequisites
            watch_site
            ;;
        check)
            check_prerequisites
            check_site
            ;;
        setup)
            setup_environment
            ;;
        help)
            show_usage
            ;;
        *)
            log_error "Unknown command: $COMMAND"
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
