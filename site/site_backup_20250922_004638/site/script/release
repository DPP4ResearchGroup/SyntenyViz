#!/bin/bash
# Release script for Jekyll theme
# Handles versioning, building, testing, and publishing

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
GEMSPEC_FILE="jekyll-theme-architect.gemspec"
RELEASE_BRANCH="master"
DRY_RUN=false

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run)
                DRY_RUN=true
                log_info "Dry run mode enabled"
                shift
                ;;
            --help|-h)
                echo "Usage: $0 [--dry-run] [--help]"
                echo "  --dry-run    Show what would be done without executing"
                echo "  --help       Show this help message"
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
}

# Check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."
    
    # Make sure we're in the project root
    cd "$(dirname "$0")/.."
    
    # Check if we're in a git repository
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        log_error "Not in a git repository"
        exit 1
    fi
    
    # Check if gemspec exists
    if [ ! -f "$GEMSPEC_FILE" ]; then
        log_error "Gemspec file not found: $GEMSPEC_FILE"
        exit 1
    fi
    
    # Check if we're on the correct branch
    local current_branch=$(git branch --show-current)
    if [ "$current_branch" != "$RELEASE_BRANCH" ]; then
        log_error "Must be on '$RELEASE_BRANCH' branch to release. Current: $current_branch"
        exit 1
    fi
    
    # Check if working directory is clean
    if ! git diff-index --quiet HEAD --; then
        log_error "Working directory is not clean. Commit or stash changes first."
        git status --short
        exit 1
    fi
    
    # Check if we have uncommitted changes
    if [ -n "$(git status --porcelain)" ]; then
        log_error "Working directory has uncommitted changes"
        git status --short
        exit 1
    fi
    
    log_success "Prerequisites check passed"
}

# Update dependencies
update_dependencies() {
    log_info "Updating dependencies..."
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would run: bundle update"
        return 0
    fi
    
    if ! bundle update; then
        log_error "Failed to update dependencies"
        exit 1
    fi
    
    log_success "Dependencies updated"
}

# Run tests before release
run_tests() {
    log_info "Running tests before release..."
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would run: script/cibuild"
        return 0
    fi
    
    if ! script/cibuild; then
        log_error "Tests failed. Cannot proceed with release."
        exit 1
    fi
    
    log_success "All tests passed"
}

# Extract version from gemspec
get_version() {
    if [ ! -f "$GEMSPEC_FILE" ]; then
        log_error "Gemspec file not found"
        exit 1
    fi
    
    # Extract version using Ruby
    local version=$(ruby -e "require_relative '$GEMSPEC_FILE'; puts Gem::Specification.load('$GEMSPEC_FILE').version")
    
    if [ -z "$version" ]; then
        log_error "Could not extract version from gemspec"
        exit 1
    fi
    
    echo "$version"
}

# Build gem
build_gem() {
    log_info "Building gem..."
    
    local version=$(get_version)
    local gem_file="jekyll-theme-architect-${version}.gem"
    
    # Clean previous gem builds
    rm -f jekyll-theme-architect-*.gem
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would build gem: $gem_file"
        return 0
    fi
    
    if ! gem build -q "$GEMSPEC_FILE"; then
        log_error "Failed to build gem"
        exit 1
    fi
    
    if [ ! -f "$gem_file" ]; then
        log_error "Gem file not created: $gem_file"
        exit 1
    fi
    
    log_success "Gem built: $gem_file"
    echo "Gem size: $(du -h "$gem_file" | cut -f1)"
}

# Check if version already exists
check_version_exists() {
    local version=$(get_version)
    local tag="v${version}"
    
    log_info "Checking if version $version already exists..."
    
    # Fetch latest tags
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would run: git fetch -t origin"
    else
        git fetch -t origin
    fi
    
    if git tag -l | grep -q "^${tag}$"; then
        log_error "Version $version already exists (tag: $tag)"
        log_info "Available tags:"
        git tag -l | sort -V | tail -10
        exit 1
    fi
    
    log_success "Version $version is available for release"
}

# Push gem to RubyGems
push_gem() {
    local version=$(get_version)
    local gem_file="jekyll-theme-architect-${version}.gem"
    
    log_info "Pushing gem to RubyGems..."
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would run: gem push $gem_file"
        return 0
    fi
    
    if ! gem push "$gem_file"; then
        log_error "Failed to push gem to RubyGems"
        exit 1
    fi
    
    log_success "Gem pushed to RubyGems"
}

# Create and push git tag
create_tag() {
    local version=$(get_version)
    local tag="v${version}"
    
    log_info "Creating and pushing git tag: $tag"
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would run: git tag $tag"
        log_info "[DRY RUN] Would run: git push origin $RELEASE_BRANCH"
        log_info "[DRY RUN] Would run: git push origin $tag"
        return 0
    fi
    
    # Create tag
    if ! git tag "$tag"; then
        log_error "Failed to create tag: $tag"
        exit 1
    fi
    
    # Push branch and tag
    if ! git push origin "$RELEASE_BRANCH"; then
        log_error "Failed to push branch: $RELEASE_BRANCH"
        exit 1
    fi
    
    if ! git push origin "$tag"; then
        log_error "Failed to push tag: $tag"
        exit 1
    fi
    
    log_success "Tag created and pushed: $tag"
}

# Generate release notes
generate_release_notes() {
    local version=$(get_version)
    local tag="v${version}"
    local notes_file="RELEASE_NOTES_${version}.md"
    
    log_info "Generating release notes..."
    
    {
        echo "# Release Notes - $tag"
        echo ""
        echo "**Release Date:** $(date)"
        echo "**Version:** $version"
        echo ""
        echo "## Changes"
        echo ""
        # Get commits since last tag
        local last_tag=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo "")
        if [ -n "$last_tag" ]; then
            echo "### Commits since $last_tag:"
            echo ""
            git log --oneline --no-merges "${last_tag}..HEAD" | sed 's/^/- /'
        else
            echo "### All commits:"
            echo ""
            git log --oneline --no-merges | sed 's/^/- /'
        fi
        echo ""
        echo "## Installation"
        echo ""
        echo "Add this line to your application's Gemfile:"
        echo ""
        echo "\`\`\`ruby"
        echo "gem 'jekyll-theme-architect', '~> $version'"
        echo "\`\`\`"
        echo ""
        echo "And then execute:"
        echo ""
        echo "\`\`\`bash"
        echo "bundle install"
        echo "\`\`\`"
    } > "$notes_file"
    
    log_success "Release notes generated: $notes_file"
}

# Main execution
main() {
    log_info "Starting release process..."
    
    parse_args "$@"
    
    local start_time=$(date +%s)
    
    check_prerequisites
    update_dependencies
    run_tests
    check_version_exists
    build_gem
    push_gem
    create_tag
    generate_release_notes
    
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    local version=$(get_version)
    
    if [ "$DRY_RUN" = true ]; then
        log_success "Dry run completed successfully in ${duration}s!"
        log_info "Would release version: $version"
    else
        log_success "Release completed successfully in ${duration}s!"
        log_success "Released version: $version"
        log_info "Gem: jekyll-theme-architect-${version}.gem"
        log_info "Tag: v${version}"
    fi
}

# Run main function
main "$@"
